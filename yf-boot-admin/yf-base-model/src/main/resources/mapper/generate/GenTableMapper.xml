<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yf.mapper.generate.GenTableMapper">

    <select id="getDatabaseTable" resultType="com.yf.model.generate.bo.SyncGenTableBo">
        SELECT table_name,
               table_comment,
               create_time,
               update_time
        FROM information_schema.tables
        WHERE table_schema = DATABASE()
          AND table_name NOT LIKE 'gen%';
    </select>
</mapper>