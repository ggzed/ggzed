<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yf.mapper.system.SysMenuMapper">

    <!-- 路由菜单信息映射 -->
    <resultMap id="RouteBoMap" type="com.yf.model.system.bo.RouteBo">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="redirect" column="redirect"/>
        <result property="name" column="name"/>
        <association property="meta" javaType="com.yf.model.system.dto.RouteMeta">
            <result property="title" column="name"/>
            <result property="icon" column="icon"/>
            <result property="hidden" column="hidden"/>
            <result property="keepAlive" column="keep_alive"/>
            <result property="affix" column="affix"/>
            <result property="breadcrumb" column="breadcrumb"/>
            <result property="showSingleChildren" column="show_single_children"/>
            <collection property="roles" ofType="java.lang.String">
                <result column="code"/>
            </collection>
        </association>
    </resultMap>

    <!-- 路由菜单信息映射 -->
    <resultMap id="MenuAndChildrenBoMap" type="com.yf.model.system.bo.MenuAndChildrenBo">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
    </resultMap>

    <!--  
        解释:
        <otherwise>
                AND menu.id = -1       // 为了让 roles 为空的时候返回一个空的权限信息
        </otherwise>
    -->
    <select id="listPermissions" resultType="java.lang.String">
        SELECT
        DISTINCT menu.permission
        FROM
        sys_menu menu
        INNER JOIN sys_role_menu role_menu ON menu.id = role_menu.menu_id
        INNER JOIN sys_role role ON role.id = role_menu.role_id
        WHERE
        menu.type IN (#{menuType.value}, #{buttonType.value})
        AND menu.permission IS NOT NULL
        <choose>
            <when test="roles != null and roles.size() > 0">
                AND role.CODE IN
                <foreach collection="roles" item="role" separator="," open="(" close=")">
                    #{role}
                </foreach>
            </when>
            <otherwise>
                AND menu.id = -1
            </otherwise>
        </choose>
    </select>
    <!--
    解释: 查询菜单集合 , 除按钮以外
    -->
    <select id="listRoutes" resultMap="RouteBoMap">
        SELECT menu.id,
               menu.name,
               menu.parent_id,
               menu.path,
               menu.component,
               menu.icon,
               menu.sort,
               menu.hidden,
               menu.affix,
               menu.redirect,
               menu.type,
               menu.breadcrumb,
               menu.show_single_children,
               menu.keep_alive,
               role.code
        FROM sys_menu menu
                 LEFT JOIN sys_role_menu role_menu ON menu.id = role_menu.menu_id
                 LEFT JOIN sys_role role ON role_menu.role_id = role.id
        WHERE menu.type != #{menuTypeEnum.value}
        ORDER BY menu.sort asc
    </select>

    <!--  查询菜单以及子菜单  -->
    <select id="getMenuAndChildrenByIds" resultMap="MenuAndChildrenBoMap">
        SELECT
        id,
        parent_id
        FROM
        sys_menu
        <where>
            <foreach collection="menuIds" item="menuId" separator=" OR " open="(" close=")">
                id = #{menuId} OR CONCAT(',', tree_path, ',') LIKE CONCAT('%,', #{menuId}, ',%')
            </foreach>
        </where>
    </select>

    <!-- 批量保存菜单 -->
    <insert id="saveBatch">
        INSERT INTO sys_menu
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="list[0].parentId != null">parent_id,</if>
            <if test="list[0].treePath != null">tree_path,</if>
            <if test="list[0].name != null">`name`,</if>
            <if test="list[0].type != null">`type`,</if>
            <if test="list[0].path != null">`path`,</if>
            <if test="list[0].component != null">component,</if>
            <if test="list[0].permission != null">permission,</if>
            <if test="list[0].hidden != null">hidden,</if>
            <if test="list[0].keepAlive != null">keep_alive,</if>
            <if test="list[0].showSingleChildren != null">show_single_children,</if>
            <if test="list[0].affix != null">affix,</if>
            <if test="list[0].icon != null">icon,</if>
            <if test="list[0].breadcrumb != null">breadcrumb,</if>
            <if test="list[0].sort != null">sort,</if>
            <if test="list[0].redirect != null">redirect,</if>
        </trim>
        VALUES
        <foreach collection="list" item="item" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="item.parentId != null">#{item.parentId},</if>
                <if test="item.treePath != null">#{item.treePath},</if>
                <if test="item.name != null">#{item.name},</if>
                <if test="item.type != null">#{item.type},</if>
                <if test="item.path != null">#{item.path},</if>
                <if test="item.component != null">#{item.component},</if>
                <if test="item.permission != null">#{item.permission},</if>
                <if test="item.hidden != null">#{item.hidden},</if>
                <if test="item.keepAlive != null">#{item.keepAlive},</if>
                <if test="item.showSingleChildren != null">#{item.showSingleChildren},</if>
                <if test="item.affix != null">#{item.affix},</if>
                <if test="item.icon != null">#{item.icon},</if>
                <if test="item.breadcrumb != null">#{item.breadcrumb},</if>
                <if test="item.sort != null">#{item.sort},</if>
                <if test="item.redirect != null">#{item.redirect},</if>
            </trim>
        </foreach>
    </insert>

</mapper>